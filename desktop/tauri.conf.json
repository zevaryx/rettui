{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rettui Desktop",
  "identifier": "io.github.zevaryx.rettui",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Reticulum client: LXMF messaging, NomadNet browsing and RRC chat",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "mainBinaryName": "rettui-desktop"
}
