[Desktop Entry]
Type=Application
Name=rettui
GenericName=Reticulum client
Comment=LXMF messaging, NomadNet browsing and RRC chat over Reticulum
Exec=rettui-desktop
Icon=rettui-desktop
Terminal=false
Categories=Network;Chat;InstantMessaging;
StartupWMClass=rettui-desktop
Actions=manage;

[Desktop Action manage]
Name=Identities, backups and pipes
Exec=rettui-desktop --manage
